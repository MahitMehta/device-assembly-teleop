ROS_DOMAIN_ID=67

# UR controller, and coral's address on the robot's network (the arm connects back to it).
ROBOT_IP=10.168.4.208
REVERSE_IP=10.168.4.33

# This machine's address on the robot network, which carries ROS traffic between coral and the
# wrist-camera laptop: 10.168.4.33 on coral, the laptop's own 10.168.4.x address on the laptop.
DDS_IP=10.168.4.33

# Camera laptop only: serial number of the wrist RealSense, so the camera service opens it and not
# another one plugged into the same machine. Find it with:
#   docker compose run --rm --entrypoint scripts/ros.sh camera rs-enumerate-devices -s
# Empty: the first RealSense found.
CAMERA_SERIAL=

# coral's Tailscale IP, and the Tailscale IP of the computer the headset is plugged into
# (`tailscale ip -4` on that computer). teleop_node accepts poses only from SENDER_IP.
CORAL_IP=100.89.37.109
SENDER_IP=100.107.32.64

# Payload set on the arm when teleop goes live: mass (kg) and centre of gravity from the
# flange (m, tool0 frame). Robotiq's 2F-85 + coupling spec; the camera mount and RealSense
# are not included yet: measure with the pendant's payload estimation and put the values here.
# PAYLOAD_MASS=0 leaves the arm's payload unchanged.
PAYLOAD_MASS=0.925
PAYLOAD_COG_X=0.0
PAYLOAD_COG_Y=0.0
PAYLOAD_COG_Z=0.058
